rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /productos/{docId} {
      allow read, write: if true;
    }
    match /categorias/{docId} {
      allow read, write: if true;
    }
    match /promociones/{docId} {
      allow read, write: if true;
    }
    match /pedidos/{docId} {
      allow read, write: if true;
    }
  }
}